# Copy to .env.local and fill in. Server-side only: never exposed to the browser,
# never logged, and .env.local is git-ignored.

# --- Conversation and game actions (Claude, called directly) -----------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. Default: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. low | medium | high (default low: snappy voice turns)
ANTHROPIC_EFFORT=low

# --- OpenRouter (one key for the AI companion, voice, avatars and daily games) -
# Without ANTHROPIC_API_KEY the conversation also runs through OpenRouter.
OPENROUTER_API_KEY=sk-or-your-team-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model overrides (defaults shown)
# Daily games, baselines, interview replies, life-story memories:
OPENROUTER_SMART_MODEL=anthropic/claude-sonnet-5.5
# Quick structured jobs:
OPENROUTER_FAST_MODEL=openai/gpt-6-luna
# Hears recordings (transcripts, voice matching) and sees photos:
OPENROUTER_MEDIA_MODEL=google/gemini-3.8-flash
# Avatars and storybook illustrations:
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2
# Live voice turns in the games (defaults to the smart model):
OPENROUTER_AGENT_MODEL=
# Optional. Default: the exact model ID from the brief
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts-20260922
# Optional. Gemini voice. Default Sulafat ("warm"). Also good: Achernar (soft), Vindemiatrix (gentle), Gacrux (mature)
OPENROUTER_TTS_VOICE=Sulafat
# Optional. Hard cap on characters sent for speech per day (every phrase is cached on disk)
TTS_DAILY_CHAR_LIMIT=60000

# --- Optional: true voice cloning (ElevenLabs instant clone from the interview) -
# Without it, the companion speaks in a Gemini voice matched to the family member.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Caregiver push notifications (Web Push / VAPID) --------------------------
# Optional: if empty, keys are generated once and stored in the local database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:team@example.com
VAPID_SUBJECT=mailto:one-more-story@example.com

# --- Storage -------------------------------------------------------------------
# Optional. Where the SQLite database, photos and recordings live. Default ./data
DATA_DIR=
