# Copy to .env.local and fill in. Server-side only: never exposed to the browser,
# never logged, and .env.local is git-ignored.

# --- Conversation and game actions (Claude, called directly) -----------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. Default: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Optional. low | medium | high (default low: snappy voice turns)
ANTHROPIC_EFFORT=low

# --- Speaking (sponsored OpenRouter team key, $40 limit: spoken replies only) -
OPENROUTER_API_KEY=sk-or-your-team-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional. Default: the exact model ID from the brief
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts-20260922
# Optional. Gemini voice. Default Sulafat ("warm"). Also good: Achernar (soft), Vindemiatrix (gentle), Gacrux (mature)
OPENROUTER_TTS_VOICE=Sulafat
# Optional. Hard cap on characters sent for speech per day (every phrase is cached on disk)
TTS_DAILY_CHAR_LIMIT=60000

# --- Caregiver push notifications (Web Push / VAPID) --------------------------
# Optional: if empty, keys are generated once and stored in the local database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:team@example.com
VAPID_SUBJECT=mailto:one-more-story@example.com

# --- Storage -------------------------------------------------------------------
# Optional. Where the SQLite database, photos and recordings live. Default ./data
DATA_DIR=
